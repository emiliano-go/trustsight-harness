        "diff": "--- a/PKGBUILD\n+++ b/PKGBUILD\n@@ -1,11 +1,12 @@\n-# Maintainer: Glass Alarm Developer\n-# Contributor: Arch Linux User\n+# Maintainer: DMK_X\n+# Prebuilt binary package \u2014 installs the published release asset with pacman -U\n+# (through an AUR helper), so no compiler or Qt development headers are needed.\n \n pkgname=lumalarm\n pkgver=1.0.5\n pkgrel=1\n pkgdesc=\"Glassmorphism alarm clock for Linux with rtcwake, D-Bus wake helper, multilingual UI and emoji-density control\"\n-arch=('x86_64' 'aarch64')\n+arch=('x86_64')\n url=\"https://github.com/shinigami1231111/lumalarm\"\n license=('GPL-3.0-or-later')\n depends=(\n@@ -14,44 +15,18 @@\n     'qt6-declarative'\n     'util-linux'\n )\n-makedepends=(\n-    'cmake'\n-    'gcc'\n-    'qt6-tools'\n-)\n optdepends=(\n-    'kwindowsystem: native KDE/KWin blur-behind (requires a rebuild with blur enabled)'\n+    'kwindowsystem: native KDE/KWin blur-behind (binary is built with blur off; source rebuild required)'\n )\n install=lumalarm.install\n-source=(\"${pkgname}-${pkgver}.tar.gz::https://github.com/shinigami1231111/lumalarm/archive/refs/tags/v${pkgver}.tar.gz\")\n-sha256sums=('418c7e93dc295a4a4e548ea184ac37b0a25dca1b2dcc9bd6bd5bed47f1cbc638')\n-\n-build() {\n-    cd \"${srcdir}/${pkgname}-${pkgver}\"\n-\n-    # KDE blur is optional and needs KF6WindowSystem at build AND run time;\n-    # keep the AUR build portable. Native translucency still works.\n-    cmake -B build \\\n-        -DCMAKE_INSTALL_PREFIX=/usr \\\n-        -DCMAKE_BUILD_TYPE=Release \\\n-        -DCMAKE_CXX_FLAGS=\"-O2 -pipe\" \\\n-        -DLUMALARM_ENABLE_KDE_BLUR=OFF\n-\n-    # Cap parallel jobs at 80% of available CPUs (never more, never zero).\n-    local jobs=$(( $(nproc) * 80 / 100 ))\n-    [ \"$jobs\" -lt 1 ] && jobs=1\n-    cmake --build build -j\"$jobs\"\n-}\n+source=(\"lumalarm-${pkgver}-${pkgrel}-${CARCH}.pkg.tar.zst::https://raw.githubusercontent.com/shinigami1231111/lumalarm/release-assets/lumalarm-${pkgver}-${pkgrel}-${CARCH}.pkg.tar.zst\")\n+sha256sums=('190a842a4f8f71b01674d055539b7f2ee0612d5d616aa135ba8df4ba30ebf367')\n+noextract=(\"lumalarm-${pkgver}-${pkgrel}-${CARCH}.pkg.tar.zst\")\n \n package() {\n-    cd \"${srcdir}/${pkgname}-${pkgver}\"\n-    DESTDIR=\"${pkgdir}\" cmake --install build\n-\n-    install -Dm644 LICENSE \"${pkgdir}/usr/share/licenses/${pkgname}/LICENSE\"\n-    mkdir -p \"${pkgdir}/usr/share/${pkgname}/tones\"\n-    install -Dm644 resources/lumalarm.desktop \\\n-        \"${pkgdir}/usr/share/applications/${pkgname}.desktop\"\n-\n-    # STG-1.6: no sudoers rule. The D-Bus helper + polkit action are installed\n-    # by CMake; lumalarm.install removes any legacy rule on upgrade.\n+    # Extract only the installed payload; metadata (.PKGINFO/.MTREE/.INSTALL)\n+    # is regenerated by makepkg from this PKGBUILD and lumalarm.install.\n+    tar --use-compress-program=zstd \\\n+        -xf \"${srcdir}/lumalarm-${pkgver}-${pkgrel}-${CARCH}.pkg.tar.zst\" \\\n+        -C \"${pkgdir}\" usr\n }",
