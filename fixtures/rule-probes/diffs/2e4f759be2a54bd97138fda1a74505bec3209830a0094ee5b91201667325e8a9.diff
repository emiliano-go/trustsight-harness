+  cd "$pkgname"
+  # update gettext infrastructure
+  cp -Rv /usr/share/gettext/po .
+  aclocal && automake --add-missing && autoconf
 }
 
 build() {
-	cd "${srcdir}/${pkgname}-${pkgver}"
-	./configure --prefix=/usr --mandir=/usr/share/man
-	make
-	cd po && make update-po
+  cd "$pkgname"
+  ./configure --prefix=/usr --mandir=/usr/share/man
+  make
+  cd po && make update-po
 }
 
